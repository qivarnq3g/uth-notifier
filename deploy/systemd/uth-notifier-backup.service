[Unit]
Description=UTH Notifier PostgreSQL backup
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=postgres
Group=postgres
Environment=POSTGRES_DB=uth_notifier
Environment=BACKUP_DIRECTORY=/var/backups/uth-notifier
Environment=BACKUP_RETENTION_DAYS=14
ExecStart=/opt/uth-notifier/current/deploy/backup-native.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
MemoryHigh=128M
MemoryMax=192M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/uth-notifier
